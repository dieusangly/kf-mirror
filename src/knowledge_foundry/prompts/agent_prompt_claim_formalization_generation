RUN = artifacts/20261028-docling-aml-cft-01
OUTPUT = artifacts/20261028-docling-aml-cft-01/formalization-v1
CORPUS = aml-cft-pilot-13
- RUN/claim-generation/claim-candidates.jsonl: the full candidate population.
