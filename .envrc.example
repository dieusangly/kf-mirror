# Copy to .envrc, set local values, then source .envrc or run direnv allow.
# Model calls:
export OPENAI_API_KEY="replace-with-your-openai-api-key"

# Existing PostgreSQL with pgvector installed:
export KF_DATABASE_URL="postgresql://knowledge_foundry:replace-with-a-local-password@127.0.0.1:5432/knowledge_foundry"
