{
  "root": "..",
  "manifest_file": "data/manifest.json",
  "manifest_ids": [
    "A",
    "T",
    "L1",
    "L2",
    "P",
    "BASEL20",
    "NRA23",
    "R24EN",
    "R24FR",
    "TFR23EN",
    "KYC21",
    "GEL26",
    "PANN24"
  ],
  "chunking": {
    "max_tokens": 256
  },
  "evaluation": {
    "chunking": {
      "sample_per_document": 12
    }
  },
  "structuring": {
    "profile": "docling",
    "profiles": {
      "docling": {
        "provider": "internal",
        "options": {
          "pdf": {
            "backend": "docling_parse",
            "table_structure": true,
            "table_mode": "accurate",
            "artifacts_path": null
          },
          "ocr": {
            "mode": "auto",
            "languages": [
              "fra",
              "eng"
            ],
            "scale": 3.0,
            "psm": 3,
            "tesseract_cmd": "tesseract",
            "tessdata_path": null
          },
          "html": {
            "content_selector": "article.js-article-content-to-copy"
          },
          "markdown": {
            "tables": true
          },
          "docx": {
            "include_headers_footers": false
          }
        }
      },
      "unstructured": {
        "provider": "knowledge_foundry.unstructured_provider:Provider",
        "options": {
          "strategy": "hi_res",
          "languages": [
            "fra",
            "eng"
          ],
          "infer_table_structure": true,
          "hi_res_model_name": "yolox"
        },
        "source_overrides": {
          "L1": {
            "provider": "internal",
            "options": {
              "html": {
                "content_selector": "article.js-article-content-to-copy"
              }
            }
          },
          "L2": {
            "provider": "internal",
            "options": {
              "html": {
                "content_selector": "article.js-article-content-to-copy"
              }
            }
          }
        }
      }
    }
  }
}
