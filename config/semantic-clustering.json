{
  "steps": {
    "structural_chunks": {
      "version": "structural-chunks-v4"
    },
    "embeddings": {
      "provider": "openai",
      "model": "text-embedding-3-small",
      "dimensions": 1536,
      "expected_dimensions": 1536,
      "tokenizer": "cl100k_base",
      "max_input_tokens": 8192,
      "max_request_inputs": 32,
      "max_request_tokens": 32000,
      "timeout_seconds": 90,
      "retries": 2,
      "preprocessing_version": "structural-evidence-text-v1"
    },
    "semantic_clusters": {
      "version": "all-members-v1",
      "minimum_similarity": 0.8,
      "refinement_step": 0.05,
      "max_refinements": 4
    }
  },
  "request_sizing": {
    "claim_config": "claim-generation-and-classification.json"
  }
}
