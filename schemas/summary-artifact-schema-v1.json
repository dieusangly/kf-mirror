{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recursive summaries manifest and records",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "stage",
    "config",
    "preparation_manifest_sha256",
    "fixture_sha256",
    "outputs"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "stage": {
      "const": "recursive-summaries-v1"
    },
    "config": {
      "type": "object"
    },
    "preparation_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fixture_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "level",
        "input_cluster_id",
        "input_summary_ids",
        "semantic_cluster_ids",
        "original_chunk_ids",
        "document_ids",
        "evidence",
        "text",
        "review_status",
        "input_tokens",
        "generation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^summary:[a-f0-9]{64}$"
        },
        "level": {
          "type": "integer",
          "minimum": 1
        },
        "input_cluster_id": {
          "type": "string",
          "minLength": 1
        },
        "input_summary_ids": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "semantic_cluster_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "original_chunk_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "document_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "document_id",
              "element_id",
              "element_revision"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "document_id": {
                "type": "string",
                "minLength": 1
              },
              "element_id": {
                "type": "string",
                "minLength": 1
              },
              "element_revision": {
                "type": "string",
                "minLength": 1
              },
              "span": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "start",
                  "end"
                ],
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          },
          "uniqueItems": true
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "review_status": {
          "enum": [
            "draft",
            "verified",
            "rejected"
          ]
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "generation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "provider",
            "model",
            "reasoning_effort",
            "prompt_sha256",
            "request_sha256"
          ],
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            },
            "provider": {
              "enum": [
                "openai",
                "fixture"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "reasoning_effort": {
              "type": "string",
              "minLength": 1
            },
            "prompt_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "request_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "summary_cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "level",
        "summary_ids",
        "minimum_similarity",
        "semantic_cluster_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^summary-cluster:[a-f0-9]{64}$"
        },
        "level": {
          "type": "integer",
          "minimum": 2
        },
        "summary_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "minimum_similarity": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "semantic_cluster_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
