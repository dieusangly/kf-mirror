{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed semantic mapping sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_sha256", "mappings", "review"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "bundle_sha256": {"$ref": "#/$defs/hash"},
    "mappings": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/mapping"}},
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "content_sha256", "reviewer", "reviewed_at", "notes"],
      "properties": {
        "status": {"enum": ["draft", "verified", "rejected"]},
        "content_sha256": {"$ref": "#/$defs/hash"},
        "reviewer": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {"kind": {"enum": ["human", "agent"]}, "name": {"type": "string", "minLength": 1}}
        },
        "reviewed_at": {"type": "string", "format": "date-time"},
        "notes": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "atom": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string", "minLength": 1}},
    "atoms": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/atom"}},
    "mapping": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "claim_id", "claim_sha256", "jurisdiction", "valid_from", "conditions", "exceptions", "facts", "rules"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9:_-]+$"},
        "claim_id": {"type": "string", "minLength": 1},
        "claim_sha256": {"$ref": "#/$defs/hash"},
        "jurisdiction": {"type": "string", "minLength": 1},
        "valid_from": {"type": "string", "format": "date"},
        "valid_until": {"type": ["string", "null"], "format": "date"},
        "conditions": {"$ref": "#/$defs/atoms"},
        "exceptions": {
          "type": "array", "maxItems": 20,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["when", "clearance"],
            "properties": {"when": {"$ref": "#/$defs/atom"}, "clearance": {"$ref": "#/$defs/atom"}}
          }
        },
        "facts": {"$ref": "#/$defs/atoms"},
        "rules": {
          "type": "array", "maxItems": 20,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["body", "head"],
            "properties": {"body": {"$ref": "#/$defs/atoms"}, "head": {"$ref": "#/$defs/atom"}}
          }
        }
      }
    }
  }
}
