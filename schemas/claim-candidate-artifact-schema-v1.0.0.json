{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-foundry.local/schemas/claim-candidate-artifact-schema-v1.0.0.json",
  "title": "Knowledge Foundry claim candidate artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "generation_build_id", "chunk_ids", "text", "evidence", "grounding_review_status", "generation"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^candidate:.+"},
    "generation_build_id": {"type": "string", "minLength": 1},
    "chunk_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "text": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "artifact-schema-v1.0.0.json#/$defs/evidence"}},
    "grounding_review_status": {"enum": ["draft", "verified", "rejected"]},
    "generation": {"$ref": "artifact-schema-v1.0.0.json#/$defs/generation"}
  }
}
