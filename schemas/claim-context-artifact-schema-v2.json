{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen structural chunks with hierarchy and semantic clusters",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "stage",
    "config",
    "input_bundle_sha256",
    "cluster_plan_sha256",
    "generation_prompt_sha256",
    "candidate_schema_sha256",
    "outputs"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "stage": {
      "const": "claim-context-preparation"
    },
    "config": {
      "type": "object"
    },
    "input_bundle_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cluster_plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generation_prompt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidate_schema_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "$defs": {
    "structural_chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "document_id",
        "original_chunk_ids",
        "text",
        "evidence_memberships",
        "context_element_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "original_chunk_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "evidence_memberships": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reference",
              "original_chunk_ids"
            ],
            "properties": {
              "reference": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_id",
                  "document_id",
                  "element_id",
                  "element_revision"
                ],
                "properties": {
                  "source_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "document_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "element_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "element_revision": {
                    "type": "string",
                    "minLength": 1
                  },
                  "span": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "start",
                      "end"
                    ],
                    "properties": {
                      "start": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "end": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                }
              },
              "original_chunk_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "context_element_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "structural_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_chunk_ids",
        "element_ids",
        "reason",
        "strength",
        "merges"
      ],
      "properties": {
        "original_chunk_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 2
        },
        "element_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "enum": [
            "shared_element_fragments",
            "governing_context_reference",
            "ordered_list_introduction",
            "unordered_list_introduction",
            "nested_list_introduction",
            "adjacent_table_continuation",
            "adjacent_sentence_continuation",
            "same_page_unique_note_marker",
            "document_parent"
          ]
        },
        "strength": {
          "enum": [
            "identity",
            "heuristic"
          ]
        },
        "merges": {
          "type": "boolean"
        }
      }
    },
    "embedding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structural_chunk_id",
        "input_sha256",
        "cache_key",
        "cache_hit",
        "vector",
        "vector_sha256",
        "provider",
        "model",
        "dimensions",
        "preprocessing_version"
      ],
      "properties": {
        "structural_chunk_id": {
          "type": "string",
          "minLength": 1
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "cache_key": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "cache_hit": {
          "type": "boolean"
        },
        "vector": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        },
        "vector_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "provider": {
          "enum": [
            "openai",
            "fixture"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "integer",
          "minimum": 1
        },
        "preprocessing_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "semantic_cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "structural_chunk_ids",
        "original_chunk_ids",
        "document_ids",
        "input_tokens",
        "request_sha256",
        "minimum_similarity"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "structural_chunk_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "original_chunk_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "document_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "minimum_similarity": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      }
    },
    "document_structure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "elements"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "elements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "element_id"
            ],
            "properties": {
              "element_id": {
                "type": "string",
                "minLength": 1
              },
              "parent_element_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "level": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "heading_path": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "evidence_role": {
                "enum": [
                  "authoritative",
                  "structural",
                  "auxiliary"
                ]
              },
              "docling_ref": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "docling_parent_ref": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "docling_group_depth": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "hierarchy_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "element_id",
        "parent_element_id",
        "role",
        "basis"
      ],
      "properties": {
        "element_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_element_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "enum": [
            "content",
            "section",
            "numbered_paragraph",
            "list_introduction",
            "detached",
            "boxed_context"
          ]
        },
        "basis": {
          "enum": [
            "root",
            "parser_parent",
            "heading_level",
            "heading_flow",
            "numbered_paragraph_scope",
            "local_list_flow",
            "page_heading_geometry",
            "boxed_caption",
            "boxed_scope",
            "local_list_continuation"
          ]
        }
      }
    }
  }
}
