{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-foundry.local/schemas/compilation-model-output-v1.json",
  "$defs": {
    "evidence": {
      "description": "Request-local label resolved to an exact passage in a saved chunk.",
      "type": "string",
      "pattern": "^E[1-9][0-9]*$"
    }
  },
  "oneOf": [
    {
      "title": "Candidate claims",
      "type": "object",
      "additionalProperties": false,
      "required": ["claims"],
      "properties": {
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "evidence"],
            "properties": {
              "text": {"type": "string", "minLength": 1},
              "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
            }
          }
        }
      }
    },
    {
      "title": "Topic classification",
      "type": "object",
      "additionalProperties": false,
      "required": ["topic_id"],
      "properties": {"topic_id": {"type": ["string", "null"], "minLength": 1}}
    }
  ]
}
