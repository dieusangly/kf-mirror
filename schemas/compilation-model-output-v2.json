{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-foundry.local/schemas/compilation-model-output-v2.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claims",
        "coverage"
      ],
      "properties": {
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "evidence"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^E[1-9][0-9]*$"
                }
              }
            }
          }
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_id",
              "status",
              "claim_indices",
              "reason"
            ],
            "properties": {
              "evidence_id": {
                "type": "string",
                "pattern": "^E[1-9][0-9]*$"
              },
              "status": {
                "type": "string",
                "enum": [
                  "represented",
                  "non_substantive",
                  "insufficient_context",
                  "ambiguous"
                ]
              },
              "claim_indices": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "title": "Candidate claims with evidence accounting"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic_id"
      ],
      "properties": {
        "topic_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "title": "Topic classification"
    }
  ]
}
